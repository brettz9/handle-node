    "dom",
    "node",
    "delegator"
  ],
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@rollup/plugin-babel": "^7.1.0",
    "@rollup/plugin-terser": "^1.0.0",
    "@types/chai": "^5.2.3",
    "@types/jsdom": "^28.0.3",
    "@types/mocha": "^10.0.10",
    "baseline-browser-mapping": "^2.11.10",
    "c8": "^12.0.0",
    "chai": "^6.2.2",
    "eslint": "^10.8.0",
    "eslint-config-ash-nazg": "^41.1.1",
    "jsdom": "^30.0.1",
    "mocha": "^11.7.6",
    "rollup": "^4.62.4",
    "typescript": "^7.0.2"
  }
