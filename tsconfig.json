{
  "compilerOptions": {
    "lib": ["ESNext", "DOM"],
    "types": ["mocha"],
    "skipLibCheck": true,
    "moduleResolution": "nodenext",
    "module": "NodeNext",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true
  },
  "include": ["rollup.config.js", "src/**/*.js", "test/*.js"],
  "exclude": ["node_modules"]
}
